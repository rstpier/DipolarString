\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Predicted substrate-star mass function (stable branch of Fig.~\ref {fig:branch} under a log-uniform prior in central density; blue histogram), regenerated from the A8-consistent dimensionless equations, with reference values from the electron-scattering-corrected Little Red Dot masses of Rusakov et al.\ \cite  {rusakov2026}. The predicted median ($\log M = 6.02$) lies near the reported median of the seven firm masses ($\log M = 6.10$; orange line); the band indicates the 18 fainter objects (reported median $\log M \lesssim 5.6$), compatible with the low end of the branch (10\,\% quantile at $\log M = 5.49$). The hatched window is the registered prediction: a pile-up ($86\,\%$ on the corrected branch, $\sim 80\,\%$ at deposit time) in the half-decade below the cutoff $\log M_{\text  {crit}} = 6.11$. The independent dynamical-mass tension is discussed in the text and is not represented as a histogram datum.}}{45}{figure.caption.76}\protected@file@percent }
\newlabel{fig:lrd}{{5}{45}{Predicted substrate-star mass function (stable branch of Fig.~\ref {fig:branch} under a log-uniform prior in central density; blue histogram), regenerated from the A8-consistent dimensionless equations, with reference values from the electron-scattering-corrected Little Red Dot masses of Rusakov et al.\ \cite {rusakov2026}. The predicted median ($\log M = 6.02$) lies near the reported median of the seven firm masses ($\log M = 6.10$; orange line); the band indicates the 18 fainter objects (reported median $\log M \lesssim 5.6$), compatible with the low end of the branch (10\,\% quantile at $\log M = 5.49$). The hatched window is the registered prediction: a pile-up ($86\,\%$ on the corrected branch, $\sim 80\,\%$ at deposit time) in the half-decade below the cutoff $\log M_{\text {crit}} = 6.11$. The independent dynamical-mass tension is discussed in the text and is not represented as a histogram datum}{figure.caption.76}{}}
